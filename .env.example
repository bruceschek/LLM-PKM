# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Cloudflare store (the default): Workers AI embeddings + a Vectorize index.
# The API token needs the Workers AI (Read) and Vectorize (Edit) permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_VECTORIZE_INDEX=llm-pkm   # created on first run if missing

# PKM_STORE=cloudflare       # or "captain" (set aside), or "local" for offline keyword search
# PKM_MODEL=claude-opus-5
# PKM_EFFORT=low             # low | medium | high
# PKM_DATA_DIR=data          # where facts.jsonl (the raw fact log) and timings.jsonl live
# PKM_INDEX_TIMEOUT=90       # longest wait, in seconds, for a new fact to become searchable

# Captain store (set aside; PKM_STORE=captain)
# CAPTAIN_API_KEY=
# CAPTAIN_ORG_ID=            # only if your Captain account needs it
# CAPTAIN_COLLECTION=llm_pkm
