# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# PKM_STORE=wiki             # the default: no fact store, the wiki is the memory
# PKM_MODEL=claude-haiku-4-5-20251001   # chat turns (fast)
# PKM_WIKI_MODEL=claude-opus-5          # background wiki updates, pkm-ingest, pkm-lint
# PKM_EFFORT=low             # low | medium | high
# PKM_DATA_DIR=data          # where timings.jsonl (and, with a fact store, facts.jsonl) live
# PKM_WIKI_DIR=data/wiki     # Obsidian vault Claude maintains (holds real data: keep git-ignored)
# PKM_OWNER=                 # your name; if unset, the chat asks once and saves it in the vault (.owner)
# PKM_COUNTRY=US             # whose public holidays Claude is told about (ISO code); "off" for none

# --- On hold since 2026-10-06: vector search. Nothing below is needed for PKM_STORE=wiki. ---

# PKM_STORE=cloudflare       # or "captain", or "local" for offline keyword search
# PKM_WIKI_DIR=off           # with a fact store, turns the wiki layer off
# PKM_INDEX_TIMEOUT=90       # longest wait, in seconds, for a new fact to become searchable

# Cloudflare store: Workers AI embeddings + a Vectorize index.
# The API token needs the Workers AI (Read) and Vectorize (Edit) permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_VECTORIZE_INDEX=llm-pkm   # created on first run if missing

# Captain store (set aside; PKM_STORE=captain)
# CAPTAIN_API_KEY=
# CAPTAIN_ORG_ID=            # only if your Captain account needs it
# CAPTAIN_COLLECTION=llm_pkm
